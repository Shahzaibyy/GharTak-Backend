# Local development only. Generate new keys before any shared or production deploy:
#   openssl rand -base64 32
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://ghartak:ghartak@localhost:5432/ghartak?sslmode=disable
REDIS_URL=redis://localhost:6379/0
# asynq jobs (AOF + noeviction). Local docker-compose exposes this on port 6380.
REDIS_QUEUE_URL=redis://localhost:6380/0
# Optional JetStream bus. When empty, order status events enqueue asynq directly.
NATS_URL=
# Set false on a dedicated worker service so the API only enqueues.
RUN_ASYNQ_WORKER=true
MIGRATIONS_DIR=migrations
DB_MAX_CONNS=0
PII_ENCRYPTION_KEY=Iz0F6AedHsA8P+JN3G0BWlMv3sWbaSNrjhF71oFSNQk=
PHONE_HASH_KEY=TQWK1/HbV44l0LLFlVhMe/9piElwEk1G8894ueHHL00=
JWT_SIGNING_KEY=and0LXNpZ25pbmcta2V5LWV4YW1wbGUtMzJiISEhISE=
# Optional. When empty, status notifications are logged and not sent to FCM.
FCM_SERVER_KEY=
# Optional. Google sign-in returns unavailable until a credentials file or JSON is set.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_FILE=
# FIREBASE_CREDENTIALS_JSON=
# Optional. Empty S3 keys return an unsigned local upload URL for development.
# Hetzner Object Storage is S3-compatible — set endpoint + keys when ready.
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=ghartak
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Optional later: META WhatsApp / SMS / Resend. Until set, OTP is stubbed and
# development responses include dev_otp.
# META_WHATSAPP_TOKEN=
# RESEND_API_KEY=
# Mapbox backend token (Directions + Geocoding). Empty → haversine fallback / geo unavailable.
# Prefer a secret server token in production. GOOGLE_MAPBOX_API_KEY is accepted as a fallback name.
MAPBOX_BACKEND_TOKEN=
MAPBOX_BASE_URL=https://api.mapbox.com
MAPBOX_TIMEOUT_MS=3000
MAPBOX_ROUTE_CACHE_TTL=6h
MAPBOX_GEO_SEARCH_TTL=24h
MAPBOX_GEO_REVERSE_TTL=168h
ROUTE_CIRCUITY_FACTOR=1.3
ROUTE_FALLBACK_KMH=20
